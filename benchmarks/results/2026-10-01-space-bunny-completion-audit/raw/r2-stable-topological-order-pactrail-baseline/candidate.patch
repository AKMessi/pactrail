+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of ``requested``."""
+    wanted = list(requested)
+    known = set(graph)
+    for node in wanted:
+        if node not in known:
+            raise ValueError("unknown requested node %r" % (node,))
+
+    closure = set()
+    stack = list(wanted)
+    while stack:
+        node = stack.pop()
+        if node in closure:
+            continue
+        closure.add(node)
+        stack.extend(graph[node])
+
+    return [node for node in order(graph) if node in closure]
