+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of requested nodes."""
+    ordered = order(graph)
+    known = set(ordered)
+    wanted = set()
+    for name in requested:
+        if name not in known:
+            raise ValueError("unknown requested node %r" % (name,))
+    stack = list(requested)
+    while stack:
+        node = stack.pop()
+        if node in wanted:
+            continue
+        wanted.add(node)
+        stack.extend(graph[node])
+    return [n for n in ordered if n in wanted]--- a/graph.py
