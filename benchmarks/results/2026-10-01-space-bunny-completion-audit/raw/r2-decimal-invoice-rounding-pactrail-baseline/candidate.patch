+"""Currency helpers.
+
+All conversions go through ``Decimal(str(value))`` so that no binary
+floating-point intermediate ever determines the rounding, and each amount is
+rounded independently to integral cents with ROUND_HALF_UP (ties away from
+zero, which is what Decimal's ROUND_HALF_UP means for negative values).
+"""
+
+from decimal import Decimal, ROUND_HALF_UP, localcontext
+
+_CENTS = Decimal("0.01")
+
+
+def to_cents(value):
+    """Return ``value`` rounded to an integral number of cents."""
+    amount = Decimal(str(value))
+    with localcontext() as ctx:
+        # Avoid InvalidOperation on very large inputs; rounding is exact.
+        ctx.prec = max(ctx.prec, len(amount.as_tuple().digits) + 10)
+        return int(amount.quantize(_CENTS, rounding=ROUND_HALF_UP) * 100)
+
+
 def cents(amount):
-    return round(float(amount) * 100)
+    """Convert a single amount to an ``int`` number of cents."""
+    return to_cents(amount)