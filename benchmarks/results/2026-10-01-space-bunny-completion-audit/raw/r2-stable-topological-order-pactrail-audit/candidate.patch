+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of requested nodes."""
+    needed = set()
+    stack = []
+    for node in requested:
+        if node not in graph:
+            raise ValueError("unknown requested node %r" % (node,))
+        stack.append(node)
+    while stack:
+        node = stack.pop()
+        if node in needed:
+            continue
+        needed.add(node)
+        for prereq in graph[node]:
+            if prereq not in graph:
+                raise ValueError(
+                    "unknown prerequisite %r for node %r" % (prereq, node)
+                )
+            stack.append(prereq)
+    return [node for node in order(graph) if node in needed]--- a/graph.py
