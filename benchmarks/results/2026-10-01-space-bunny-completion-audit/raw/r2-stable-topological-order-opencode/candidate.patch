+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of ``requested``.
+
+    The result contains every requested node plus all of their
+    prerequisites (recursively), in an order where prerequisites precede
+    dependents.  Raises ValueError for unknown requested nodes, unknown
+    prerequisites, or cycles.  ``graph`` and ``requested`` are not mutated.
+    """
+    if isinstance(requested, (str, bytes)):
+        raise TypeError("requested must be a collection of node names")
+
+    wanted = []
+    for node in requested:
+        if node not in graph:
+            raise ValueError("unknown requested node %r" % (node,))
+        if node not in wanted:
+            wanted.append(node)
+
+    needed = set(wanted)
+    stack = list(wanted)
+    while stack:
+        node = stack.pop()
+        for dep in graph[node]:
+            if dep not in graph:
+                raise ValueError(
+                    "unknown prerequisite %r for node %r" % (dep, node)
+                )
+            if dep not in needed:
+                needed.add(dep)
+                stack.append(dep)
+
+    ordering = order({node: graph[node] for node in needed})
+    return [node for node in ordering if node in needed]--- a/graph.py
