+"""Topological ordering of a prerequisite graph.
+
+A graph is a mapping from node name to an iterable of prerequisite node
+names.  ``order`` returns a build order in which every declared node
+appears exactly once and each node's prerequisites come before it.
+"""
+
+
 def order(graph):
-    return sorted(graph)
+    """Return the topological order of ``graph``.
+
+    Ties are broken by choosing the lexicographically smallest node that is
+    currently ready, which makes the result deterministic.
+
+    Raises ValueError if a prerequisite is not a declared node, or if the
+    graph contains a cycle.  ``graph`` and its prerequisite iterables are
+    never mutated.
+    """
+    prereqs = {}
+    for node, required in graph.items():
+        deps = []
+        for dep in required:
+            if dep not in graph:
+                raise ValueError(
+                    "unknown prerequisite %r for node %r" % (dep, node)
+                )
+            if dep not in deps:
+                deps.append(dep)
+        prereqs[node] = deps
+
+    # Count only prerequisites that are themselves reachable work items.
+    remaining = {}
+    dependents = {node: [] for node in prereqs}
+    for node, deps in prereqs.items():
+        pending = 0
+        for dep in deps:
+            if dep == node:
+                pending += 1
+                continue
+            dependents[dep].append(node)
+            pending += 1
+        remaining[node] = pending
+
+    ready = sorted(node for node, count in remaining.items() if count == 0)
+    result = []
+    while ready:
+        node = ready.pop(0)
+        result.append(node)
+        for child in dependents[node]:
+            remaining[child] -= 1
+            if remaining[child] == 0:
+                ready.append(child)
+                ready.sort()
+
+    if len(result) != len(prereqs):
+        stuck = sorted(set(prereqs) - set(result))
+        raise ValueError("cycle detected involving: %s" % ", ".join(map(repr, stuck)))
+
+    return result