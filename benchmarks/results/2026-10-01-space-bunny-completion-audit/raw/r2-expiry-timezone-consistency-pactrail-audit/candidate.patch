+"""Expiry helpers shared by the cache and its callers.
+
+Datetime values are interpreted as follows: naive values are assumed to be in
+UTC, while aware values are compared as absolute instants.  No wall clock is
+read implicitly: callers always supply ``now`` explicitly.
+"""
+
+from datetime import timezone
+
+UTC = timezone.utc
+
+
+def as_utc(value):
+    """Return ``value`` as an aware UTC datetime."""
+    if value.tzinfo is None or value.tzinfo.utcoffset(value) is None:
+        return value.replace(tzinfo=UTC)
+    return value.astimezone(UTC)
+
+
 def expired(expires_at, now):
-    return now > expires_at
+    """Return True when the entry is expired at ``now``.
+
+    An entry is considered expired as soon as ``now >= expires_at``.
+    """
+    return as_utc(now) >= as_utc(expires_at)
