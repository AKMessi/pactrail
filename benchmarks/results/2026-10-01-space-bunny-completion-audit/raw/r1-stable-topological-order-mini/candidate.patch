+"""Topological ordering of a node -> prerequisites mapping."""
+
+
 def order(graph):
-    return sorted(graph)
+    """Return every declared node exactly once, prerequisites first.
+
+    Ties between simultaneously ready nodes are broken by choosing the
+    lexicographically smallest name, making the result deterministic.
+    Raises ValueError for unknown prerequisites or dependency cycles.
+    """
+    if graph is None:
+        raise ValueError("graph must be a mapping of node -> prerequisites")
+
+    # Snapshot the graph so the caller's mapping is never mutated.
+    prereqs = {}
+    for node, deps in graph.items():
+        if deps is None:
+            deps = ()
+        if isinstance(deps, str):
+            deps = (deps,)
+        try:
+            dep_list = list(deps)
+        except TypeError:
+            raise ValueError(
+                "prerequisites for %r must be an iterable of node names" % (node,)
+            )
+        prereqs[node] = dep_list
+
+    # Validate prerequisites refer to declared nodes.
+    for node, deps in prereqs.items():
+        for dep in deps:
+            if dep not in prereqs:
+                raise ValueError(
+                    "unknown prerequisite %r for node %r" % (dep, node)
+                )
+
+    remaining = {node: set(deps) for node, deps in prereqs.items()}
+    result = []
+    while remaining:
+        ready = sorted(n for n, deps in remaining.items() if not deps)
+        if not ready:
+            raise ValueError(
+                "cycle detected among nodes: %s" % (sorted(remaining),)
+            )
+        chosen = ready[0]
+        del remaining[chosen]
+        result.append(chosen)
+        for deps in remaining.values():
+            deps.discard(chosen)
+    return result
