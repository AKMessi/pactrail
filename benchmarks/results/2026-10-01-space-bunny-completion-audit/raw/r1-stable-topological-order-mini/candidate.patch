+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of ``requested``.
+
+    Uses the same deterministic ordering as graph.order.  Unknown requested
+    nodes raise ValueError.  The graph and its prerequisite lists are not
+    mutated.
+    """
+    if graph is None:
+        raise ValueError("graph must be a mapping of node -> prerequisites")
+    if requested is None:
+        requested = ()
+    if isinstance(requested, str):
+        requested = (requested,)
+    try:
+        wanted = list(requested)
+    except TypeError:
+        raise ValueError("requested must be an iterable of node names")
+
+    for node in wanted:
+        if node not in graph:
+            raise ValueError("unknown requested node %r" % (node,))
+
+    targets = set(wanted)
+    closure = set()
+    stack = list(wanted)
+    while stack:
+        node = stack.pop()
+        if node in closure:
+            continue
+        closure.add(node)
+        deps = graph[node] or ()
+        if isinstance(deps, str):
+            deps = (deps,)
+        for dep in deps:
+            if dep not in closure:
+                stack.append(dep)
+
+    # Validate prerequisites/cycles and get the canonical ordering.
+    ordered = order(graph)
+    return [node for node in ordered if node in closure or node in targets]
