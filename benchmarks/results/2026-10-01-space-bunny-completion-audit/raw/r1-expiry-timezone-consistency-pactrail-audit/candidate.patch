@@ -1,2 +1,18 @@
+"""Shared expiry semantics for absolute datetimes.
+
+Naive datetimes are interpreted as UTC; aware datetimes are compared as
+instants. Expiry is inclusive: an entry is expired once
+``now >= expires_at``.
+"""
+from datetime import datetime, timezone
+
+
+def _as_utc(value):
+    if value.tzinfo is None:
+        return value.replace(tzinfo=timezone.utc)
+    return value.astimezone(timezone.utc)
+
+
 def expired(expires_at, now):
-    return now > expires_at
+    """Return True when ``now`` has reached or passed ``expires_at``."""
+    return _as_utc(now) >= _as_utc(expires_at)
