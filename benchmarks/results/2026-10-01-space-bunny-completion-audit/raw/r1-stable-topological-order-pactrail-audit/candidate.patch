+def plan(graph, requested):
+    """Return the ordered prerequisite closure of the requested nodes."""
+    wanted = set(requested)
+    for node in wanted:
+        if node not in graph:
+            raise ValueError("unknown requested node %r" % (node,))
+
+    closure = set()
+    stack = list(wanted)
+    while stack:
+        node = stack.pop()
+        if node in closure:
+            continue
+        closure.add(node)
+        for prereq in graph[node]:
+            if prereq not in graph:
+                raise ValueError(
+                    "unknown prerequisite %r for %r" % (prereq, node)
+                )
+            stack.append(prereq)
+
+    subset = {
+        node: [p for p in graph[node] if p in closure]
+        for node in closure
+    }
+    return order(subset)--- a/graph.py
