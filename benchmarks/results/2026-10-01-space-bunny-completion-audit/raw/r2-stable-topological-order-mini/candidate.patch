+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of ``requested``."""
+    if isinstance(requested, str):
+        requested = [requested]
+    requested = list(requested)
+
+    ordered = order(graph)
+    known = set(ordered)
+    for node in requested:
+        if node not in known:
+            raise ValueError("unknown requested node: %r" % (node,))
+
+    # Transitive closure of prerequisites.
+    prereqs = {node: list(deps) for node, deps in graph.items()}
+    needed = set()
+
+    def visit(node):
+        stack = [node]
+        while stack:
+            current = stack.pop()
+            if current in needed:
+                continue
+            needed.add(current)
+            stack.extend(prereqs[current])
+
+    for node in requested:
+        visit(node)
+
+    return [node for node in ordered if node in needed]
