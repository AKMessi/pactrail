+"""Topological ordering of a prerequisite graph."""
+
+
 def order(graph):
-    return sorted(graph)
+    """Return every declared node exactly once, prerequisites first.
+
+    ``graph`` maps a node name to an iterable of its prerequisite node names.
+    Each step emits the lexicographically smallest currently-ready node, so
+    the result is deterministic.  Unknown prerequisites and cycles raise
+    ``ValueError``.  The graph and its prerequisite lists are not mutated.
+    """
+    prereqs = {}
+    for node, deps in graph.items():
+        deps = list(deps)
+        prereqs[node] = deps
+        for dep in deps:
+            if dep not in prereqs and dep not in graph:
+                raise ValueError("unknown prerequisite: %r (of %r)" % (dep, node))
+
+    remaining = {node: set(deps) for node, deps in prereqs.items()}
+    dependents = {node: set() for node in prereqs}
+    for node, deps in prereqs.items():
+        for dep in deps:
+            dependents[dep].add(node)
+
+    result = []
+    while remaining:
+        ready = [n for n, deps in remaining.items() if not deps]
+        if not ready:
+            raise ValueError("cycle detected in graph")
+        node = min(ready)
+        del remaining[node]
+        for dependent in dependents[node]:
+            if dependent in remaining:
+                remaining[dependent].discard(node)
+        result.append(node)
+    return result
