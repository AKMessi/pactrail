--- a/clock.py
+++ b/clock.py
@@ -1,2 +1,17 @@
+from datetime import timezone
+
+
+def _instant(moment):
+    """Return a naive UTC datetime for a naive-or-aware datetime."""
+    if moment.tzinfo is None:
+        return moment
+    return moment.astimezone(timezone.utc).replace(tzinfo=None)
+
+
 def expired(expires_at, now):
-    return now > expires_at
+    """True if an entry expiring at expires_at is expired as of now.
+
+    Naive datetimes are interpreted as UTC; aware datetimes are compared as
+    instants. An entry is expired once now >= expires_at.
+    """
+    return _instant(now) >= _instant(expires_at)
