+def plan(graph, requested):
+    """Return the ordered transitive prerequisite closure of ``requested``."""
+    requested = list(requested)
+    unknown = [n for n in requested if n not in graph]
+    if unknown:
+        raise ValueError("unknown requested nodes: %s" % ", ".join(sorted(unknown)))
+
+    seen = set()
+    stack = list(requested)
+    while stack:
+        node = stack.pop()
+        if node in seen:
+            continue
+        seen.add(node)
+        stack.extend(graph[node])
+
+    subgraph = dict((node, graph[node]) for node in seen)
+    return order(subgraph)--- a/graph.py
