+def _kahn(prereqs):
+    indegree = dict((node, len(deps)) for node, deps in prereqs.items())
+    dependents = dict((node, []) for node in prereqs)
+    for node, deps in prereqs.items():
+        for dep in deps:
+            dependents[dep].append(node)
+
+    ready = [node for node, count in indegree.items() if count == 0]
+    heapq.heapify(ready)
+
+    result = []
+    while ready:
+        node = heapq.heappop(ready)
+        result.append(node)
+        for other in dependents[node]:
+            indegree[other] -= 1
+            if indegree[other] == 0:
+                heapq.heappush(ready, other)
+
+    if len(result) != len(prereqs):
+        remaining = sorted(n for n in prereqs if n not in set(result))
+        raise ValueError("cycle detected involving nodes: %s" % ", ".join(remaining))
